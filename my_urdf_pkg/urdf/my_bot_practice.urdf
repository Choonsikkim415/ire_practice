<?xml version="1.0"?>
<robot name="my_bot_practice">
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.1" rpy="0 0 0"/>
            <geometry>
                <box size="0.4 0.2 0.2"/>
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
    </link>

    <link name="first_link_yaw"/>

    <link name="first_link">
        <visual>
            <origin xyz="0 0 0.15" rpy="0 0 0"/>
            <geometry>
                <cylinder length="0.3" radius="0.03"/>
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
    </link>

    <link name="second_link">
        <visual>
            <origin xyz="0.15 0 0" rpy="0 1.5708 0"/>
            <geometry>
                <cylinder length="0.3" radius="0.03"/>
            </geometry>
            <material name="gray">
                <color rgba="0.5 0.5 0.5 1"/>
            </material>
        </visual>
    </link>

    <joint name="base_to_yaw" type="revolute">
        <parent link="base_link"/>
        <child link="first_link_yaw"/>
        <origin xyz="0.1 0 0.23"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="1.0"/>
    </joint>

    <joint name="yaw_to_first" type="revolute">
        <parent link="first_link_yaw"/>
        <child link="first_link"/>
        <origin xyz="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="0" upper="1.5708" effort="1.0" velocity="1.0"/>
    </joint>

    <joint name="neck_to_second" type="revolute">
        <parent link="first_link"/>
        <child link="second_link"/>
        <origin xyz="0 0 0.33"/>
        <axis xyz="0 1 0"/>
        <limit lower="-1.5708" upper="0" effort="1.0" velocity="1.0"/>
    </joint>
</robot>